{
  "name": "dashboardv1",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "fetch": "npm run fetch --workspace=server"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^4.0.3",
    "csv-parse": "^6.2.1"
  }
}
